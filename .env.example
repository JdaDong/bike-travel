# 复制为 .env 后填入；不填则后端使用 Demo Provider，应用仍可运行
AMAP_KEY=
AMAP_REST_HOST=https://restapi.amap.com
# 自托管 Valhalla 骑行路由 base（末尾不带斜杠）。例如 http://localhost:8002
VALHALLA_URL=
# OSM/OSRM 骑行路由 base（末尾带斜杠）。例如 https://router.project-osrm.org/route/v1/cycling/
OSM_ROUTING_URL=
# 端口请在 config/ports.env 中统一配置（SERVER_PORT / WEB_PORT）
