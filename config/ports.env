# =============================================================================
# bike-travel 端口配置 —— 单一可信源 (single source of truth)
# -----------------------------------------------------------------------------
# 修改本文件即可调整后端与前端端口，start/stop/restart 三个脚本都会读取此处，
# vite.config.ts 与 server env 也会据此自动适配（含 /api、/ws 代理目标）。
#
# 如需本地临时覆盖（不提交到仓库），请创建同目录下的 config/ports.env.local，
# 它已被 .gitignore 忽略，且优先级高于本文件。
# =============================================================================

# 后端 API / WebSocket 端口（Fastify 监听）
# 前端开发服务器的 /api 与 /ws 代理都会指向该端口。
SERVER_PORT=3001

# 前端 Vite 开发服务器端口（浏览器访问地址）
WEB_PORT=5273
